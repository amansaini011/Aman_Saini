{% doc %}
  @prompt
    Create a free shipping progress bar that displays inside the cart drawer. It should show: a message "Add [amount] to get free shipping" that dynamically updates based on cart total, a progress bar that fills up as cart value increases toward the free shipping threshold, and a success message with a truck/shipping icon when free shipping is unlocked. Use warm brown and orange colors. The free shipping threshold amount should be a configurable setting. This block must be compatible with and placed inside the cart drawer section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign free_shipping_threshold = block.settings.free_shipping_threshold | times: 100 %}
{% assign cart_total = cart.total_price %}
{% assign remaining_amount = free_shipping_threshold | minus: cart_total %}
{% assign progress_percentage = cart_total | times: 100 | divided_by: free_shipping_threshold %}

{% if progress_percentage > 100 %}
  {% assign progress_percentage = 100 %}
{% endif %}

{% style %}
  .ai-free-shipping-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-free-shipping-bar__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-free-shipping-bar__message-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    font-weight: 500;
    line-height: 1.4;
  }

  .ai-free-shipping-bar__success-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.success_text_color }};
    font-weight: 600;
  }

  .ai-free-shipping-bar__success-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .ai-free-shipping-bar__success-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.success_text_color }};
  }

  .ai-free-shipping-bar__progress-container-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.bar_height }}px;
    background-color: {{ block.settings.bar_background_color }};
    border-radius: {{ block.settings.bar_border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-free-shipping-bar__progress-fill-{{ ai_gen_id }} {
    height: 100%;
    background: {{ block.settings.bar_fill_color }};
    border-radius: {{ block.settings.bar_border_radius }}px;
    transition: width 0.4s ease;
    position: relative;
  }

  .ai-free-shipping-bar__amount-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.highlight_color }};
  }
{% endstyle %}

<free-shipping-bar-{{ ai_gen_id }}
  class="ai-free-shipping-bar-{{ ai_gen_id }}"
  data-threshold="{{ free_shipping_threshold }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-free-shipping-bar__content-{{ ai_gen_id }}">
    {% if remaining_amount > 0 %}
      <div class="ai-free-shipping-bar__message-{{ ai_gen_id }}">
        {% if block.settings.message_text != blank %}
          {{ block.settings.message_text | replace: '[amount]', '<span class="ai-free-shipping-bar__amount-' | append: ai_gen_id | append: '">' | append: remaining_amount | money | append: '</span>' }}
        {% else %}
          Add <span class="ai-free-shipping-bar__amount-{{ ai_gen_id }}">{{ remaining_amount | money }}</span> to get free shipping
        {% endif %}
      </div>
      <div class="ai-free-shipping-bar__progress-container-{{ ai_gen_id }}">
        <div
          class="ai-free-shipping-bar__progress-fill-{{ ai_gen_id }}"
          style="width: {{ progress_percentage }}%;"
        ></div>
      </div>
    {% else %}
      <div class="ai-free-shipping-bar__success-{{ ai_gen_id }}">
        <span class="ai-free-shipping-bar__success-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M1 6v14a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H3a2 2 0 0 0-2 2zm19 14H3V6h17v14z"/>
            <path d="M16 8h3v4h-3zM1 10h15v2H1z"/>
            <circle cx="6" cy="18.5" r="1.5"/>
            <circle cx="15" cy="18.5" r="1.5"/>
          </svg>
        </span>
        <span>
          {% if block.settings.success_message != blank %}
            {{ block.settings.success_message }}
          {% else %}
            You've unlocked free shipping!
          {% endif %}
        </span>
      </div>
    {% endif %}
  </div>
</free-shipping-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class FreeShippingBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.threshold = parseInt(this.dataset.threshold);
      }

      connectedCallback() {
        this.updateProgressBar();
        document.addEventListener('cart:updated', this.updateProgressBar.bind(this));
      }

      disconnectedCallback() {
        document.removeEventListener('cart:updated', this.updateProgressBar.bind(this));
      }

      updateProgressBar() {
        fetch('/cart.js')
          .then(response => response.json())
          .then(cart => {
            const cartTotal = cart.total_price;
            const remaining = this.threshold - cartTotal;
            const percentage = Math.min((cartTotal / this.threshold) * 100, 100);

            const contentContainer = this.querySelector('.ai-free-shipping-bar__content-{{ ai_gen_id }}');
            
            if (remaining > 0) {
              const formattedRemaining = this.formatMoney(remaining);
              const messageText = `{{ block.settings.message_text }}` || 'Add [amount] to get free shipping';
              const finalMessage = messageText.replace('[amount]', `<span class="ai-free-shipping-bar__amount-{{ ai_gen_id }}">${formattedRemaining}</span>`);
              
              contentContainer.innerHTML = `
                <div class="ai-free-shipping-bar__message-{{ ai_gen_id }}">
                  ${finalMessage}
                </div>
                <div class="ai-free-shipping-bar__progress-container-{{ ai_gen_id }}">
                  <div
                    class="ai-free-shipping-bar__progress-fill-{{ ai_gen_id }}"
                    style="width: ${percentage}%;"
                  ></div>
                </div>
              `;
            } else {
              const successMessage = `{{ block.settings.success_message }}` || "You've unlocked free shipping!";
              contentContainer.innerHTML = `
                <div class="ai-free-shipping-bar__success-{{ ai_gen_id }}">
                  <span class="ai-free-shipping-bar__success-icon-{{ ai_gen_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M1 6v14a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H3a2 2 0 0 0-2 2zm19 14H3V6h17v14z"/>
                      <path d="M16 8h3v4h-3zM1 10h15v2H1z"/>
                      <circle cx="6" cy="18.5" r="1.5"/>
                      <circle cx="15" cy="18.5" r="1.5"/>
                    </svg>
                  </span>
                  <span>${successMessage}</span>
                </div>
              `;
            }
          });
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return new Intl.NumberFormat('{{ cart.currency.iso_code }}', {
          style: 'currency',
          currency: '{{ cart.currency.iso_code }}'
        }).format(amount);
      }
    }

    customElements.define('free-shipping-bar-{{ ai_gen_id }}', FreeShippingBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Free shipping progress",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Free shipping settings"
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "min": 10,
      "max": 500,
      "step": 10,
      "unit": "₹",
      "default": 100,
      "info": "Cart value needed for free shipping"
    },
    {
      "type": "inline_richtext",
      "id": "message_text",
      "label": "Progress message",
      "default": "Add [amount] to get free shipping",
      "info": "Use [amount] as placeholder for remaining amount"
    },
    {
      "type": "inline_richtext",
      "id": "success_message",
      "label": "Success message",
      "default": "You've unlocked free shipping!"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFF5EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5C4033"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Amount highlight color",
      "default": "#D2691E"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "min": 6,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "bar_border_radius",
      "label": "Bar border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "bar_background_color",
      "label": "Bar background color",
      "default": "#E8D5C4"
    },
    {
      "type": "color",
      "id": "bar_fill_color",
      "label": "Bar fill color",
      "default": "#D2691E"
    },
    {
      "type": "header",
      "content": "Success state"
    },
    {
      "type": "color",
      "id": "success_text_color",
      "label": "Success text color",
      "default": "#8B4513"
    }
  ],
  "presets": [
    {
      "name": "Free shipping progress"
    }
  ]
}
{% endschema %}
