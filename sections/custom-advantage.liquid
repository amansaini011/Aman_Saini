<div class="custom-advantage">
  <div class="page-width">
    <div class="custom-advantage-wrapper">
      <div class="advantage-icon-text">
        {% for block in section.blocks %}
          <div class="icon-text-ad">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}">
              <h4>{{ block.settings.heading }}</h4>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<style>
  .advantage-icon-text {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 160px;
}
    @media screen and (max-width: 768px) {
.advantage-icon-text {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 10px;
}
.icon-text-ad h4 {
    font-size: 11px;
}
    }
</style>
{% schema %}
{
  "name": "Section Advantage",
  "settings": [],
  "blocks": [
    {
      "type": "advantage_block",
      "name": "Advantage Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Advantage"
    }
  ]
}
{% endschema %}
