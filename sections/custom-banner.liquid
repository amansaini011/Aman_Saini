      "default": "#000000"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Top bar background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Choose gift button color",
      "default": "#fff53d"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}