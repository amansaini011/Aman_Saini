

<div class="tisso-section" id="tisso-section-{{ section.id }}" data-bonus-handle="{{ section.settings.bonus_product.handle }}">
  {% if section.settings.heading != blank %}
    <h2 class="tisso-heading">{{ section.settings.heading }}</h2>
  {% endif %}


  <div class="tisso-grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product != blank %}
        <div class="tisso-item" {{ block.shopify_attributes }}>
          {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
          
      
          <button type="button" class="view-product-dot" data-product-id="{{ product.id }}" aria-label="Quick View"> <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4.98047 0.75V9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M0.75 4.98071H9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
</button>

        
          <script type="application/json" class="product-data" data-id="{{ product.id }}">
            {
              "title": {{ product.title | json }},
              "handle": {{ product.handle | json }},
              "image": {{ product.featured_image | image_url: width: 500 | json }},
              "description": {{ product.description | strip_html | truncatewords: 20 | json }},
              "options": {{ product.options | json }},
              "variants": [
                {% for variant in product.variants %}
                  {
                    "id": {{ variant.id }},
                    "price": {{ variant.price }},
                    "available": {{ variant.available | json }},
                    "options": {{ variant.options | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="quick-view-modal" style="display: none;">
    <div class="quick-view-overlay"></div>
    <div class="quick-view-content">
      <button type="button" class="close-modal-btn" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#000" stroke-width="1.5">
          <path d="M1 1l12 12M13 1L1 13"/>
        </svg>
      </button>

      <div class="modal-top-row">
        <img class="modal-product-img" src="" alt="Product Image">
        <div class="modal-product-details">
          <h3 class="modal-product-title"></h3>
          <p class="modal-product-price"></p>
          <p class="modal-product-desc"></p>
        </div>
      </div>

      <div class="modal-options-wrapper"></div>

      <button type="button" class="add-to-cart-btn">
        <span>ADD TO CART</span>
        <span class="btn-arrow"></span>
      </button>

      <p class="cart-message"></p>
    </div>
  </div>
</div>

<style>
  .tisso-section {
    padding: 24px 16px;
    color: #000;
  }

  .tisso-heading {
    font-size: 18px;
    font-weight: 400;
    margin: 0 0 16px;
  }

  .tisso-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .tisso-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .tisso-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .view-product-dot {
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #FFF;
    border: 5px solid #F8F8F8E5;
    background-clip: 0;
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s ease;
    align-items: center;
    text-align: center;
    margin: auto;
    display: flex;
    justify-content: center;
}

  .view-product-dot:hover {
    transform: scale(1.2);
  }

  .quick-view-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .quick-view-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
  }

  .quick-view-content {
    position: relative;
    background: #ffffff;
    width: 100%;
    max-width: 320px;
    padding: 18px;
    z-index: 2;
    box-sizing: border-box;
  }

  .close-modal-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 24px;
    height: 24px;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .modal-top-row {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }

  .modal-product-img {
    width: 110px;
    height: 130px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .modal-product-details {
    flex: 1;
  }

  .modal-product-title {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .modal-product-price {
    font-size: 16px;
    font-weight: 400;
    margin: 0 0 8px;
  }

  .modal-product-desc {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
    color: #444;
  }

  .modal-options-wrapper {
    margin-top: 16px;
  }

  .option-group {
    margin-bottom: 16px;
  }

  .option-label {
    display: block;
    font-size: 14px;
    margin-bottom: 6px;
    font-weight: 400;
  }


  .color-buttons-container {
    display: flex;
    border: 1px solid #8a8a8a;
    height: 40px;
  }

  .color-button {
    flex: 1;
    border: none;
    background: #f2f2f2;
    color: #000;
    font-family: inherit;
    font-size: 14px;
    cursor: pointer;
    text-align: left;
    padding-left: 12px;
    position: relative;
    box-shadow: inset 3px 0 0 var(--swatch-color, #000);
    transition: background 0.2s, color 0.2s;
  }

  .color-button.active {
    background: #000;
    color: #fff;
  }


  .custom-dropdown {
    position: relative;
  }

  .custom-dropdown-btn {
    width: 100%;
    height: 40px;
    background: #ffffff;
    border: 1px solid #8a8a8a;
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 0 0 0 12px;
    font-family: inherit;
    font-size: 14px;
    text-align: left;
  }

  .custom-dropdown-btn span {
    flex: 1;
  }

  .custom-dropdown.has-selection .custom-dropdown-btn span {
    text-align: center;
  }

  .custom-dropdown-icon {
    width: 44px;
    height: 100%;
    border-left: 1px solid #8a8a8a;
    position: relative;
  }

  .custom-dropdown-icon::after {
    content: "";
    position: absolute;
    top: 45%;
    left: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid #000;
    border-bottom: 1.5px solid #000;
    transform: translate(-50%, -50%) rotate(45deg);
    transition: transform 0.2s;
  }

  .custom-dropdown.open .custom-dropdown-icon::after {
    transform: translate(-50%, -50%) rotate(225deg);
  }

  .custom-dropdown-list {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #8a8a8a;
    border-top: none;
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 140px;
    overflow-y: auto;
    z-index: 10;
  }

  .custom-dropdown.open .custom-dropdown-list {
    display: block;
  }

  .custom-dropdown-list li {
    padding: 8px 12px;
    font-size: 13px;
    text-align: center;
    cursor: pointer;
  }

  .custom-dropdown-list li:hover {
    background: #f2f2f2;
  }

  .add-to-cart-btn {
    position: relative;
    width: 100%;
    height: 44px;
    margin-top: 20px;
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    font-family: inherit;
    font-size: 15px;
    font-weight: 300;
    letter-spacing: 0.04em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 35px;
    overflow: hidden;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .add-to-cart-btn::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #ffffff;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .add-to-cart-btn:hover {
    color: #000000;
  }

  .add-to-cart-btn:hover::before {
    transform: scaleX(1);
  }

  .btn-arrow {
    width: 28px;
    height: 1px;
    background: currentColor;
    position: relative;
    transition: transform 0.3s ease;
  }

  .btn-arrow::after {
    content: "";
    position: absolute;
    right: 0;
    top: -4px;
    width: 8px;
    height: 8px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .add-to-cart-btn:hover .btn-arrow {
    transform: translateX(6px);
  }

  .cart-message {
    font-size: 12px;
    margin: 8px 0 0;
    min-height: 14px;
    text-align: center;
    color: #d32f2f;
  }

 


  
  @media (min-width: 750px) {
    .tisso-section {
      padding: 32px 48px;
    }
    .tisso-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .quick-view-content {
      max-width: 340px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('#tisso-section-{{ section.id }}');
    if (!section) return;

    var modal = section.querySelector('.quick-view-modal');
    var overlay = section.querySelector('.quick-view-overlay');
    var closeBtn = section.querySelector('.close-modal-btn');
    var addToCartBtn = section.querySelector('.add-to-cart-btn');
    var bonusHandle = section.getAttribute('data-bonus-handle');

    var currentProduct = null;
    var selectedOptions = [];

    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function getColorHex(colorName) {
      var name = colorName.toLowerCase().trim();
      if (name === 'white') return '#b5b5b5';
      if (name === 'black') return '#000000';
      if (name === 'blue') return '#1976d2';
      return name;
    }

    
    function openModal(productId) {
      var scriptData = section.querySelector('.product-data[data-id="' + productId + '"]');
      if (!scriptData) return;

      currentProduct = JSON.parse(scriptData.textContent);
      selectedOptions = [];

      modal.querySelector('.modal-product-img').src = currentProduct.image;
      modal.querySelector('.modal-product-title').textContent = currentProduct.title;
      modal.querySelector('.modal-product-desc').textContent = currentProduct.description;
      modal.querySelector('.cart-message').textContent = '';

      renderProductOptions();
      updateSelectedPrice();

      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.style.display = 'none';
      document.body.style.overflow = '';
      currentProduct = null;
    }

   
    function renderProductOptions() {
      var optionsWrapper = modal.querySelector('.modal-options-wrapper');
      optionsWrapper.innerHTML = '';

      currentProduct.options.forEach(function (optionName, optionIndex) {
        var group = document.createElement('div');
        group.className = 'option-group';

        var label = document.createElement('label');
        label.className = 'option-label';
        label.textContent = optionName;
        group.appendChild(label);

        var values = [];
        currentProduct.variants.forEach(function (v) {
          var val = v.options[optionIndex];
          if (values.indexOf(val) === -1) {
            values.push(val);
          }
        });

        if (optionName.toLowerCase().indexOf('color') !== -1 || optionName.toLowerCase().indexOf('colour') !== -1) {
          var btnContainer = document.createElement('div');
          btnContainer.className = 'color-buttons-container';

          values.forEach(function (val, idx) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'color-button';
            btn.textContent = val;
            btn.style.setProperty('--swatch-color', getColorHex(val));

            if (idx === 0) {
              btn.classList.add('active');
              selectedOptions[optionIndex] = val;
            }

            btn.addEventListener('click', function () {
              btnContainer.querySelectorAll('.color-button').forEach(function (b) {
                b.classList.remove('active');
              });
              btn.classList.add('active');
              selectedOptions[optionIndex] = val;
              updateSelectedPrice();
            });

            btnContainer.appendChild(btn);
          });

          group.appendChild(btnContainer);
        } else {
          var dropdown = document.createElement('div');
          dropdown.className = 'custom-dropdown';

          dropdown.innerHTML =
            '<button type="button" class="custom-dropdown-btn">' +
              '<span>Choose your ' + optionName.toLowerCase() + '</span>' +
              '<div class="custom-dropdown-icon"></div>' +
            '</button>' +
            '<ul class="custom-dropdown-list"></ul>';

          var dropdownBtn = dropdown.querySelector('.custom-dropdown-btn');
          var dropdownText = dropdown.querySelector('.custom-dropdown-btn span');
          var dropdownList = dropdown.querySelector('.custom-dropdown-list');

          values.forEach(function (val) {
            var li = document.createElement('li');
            li.textContent = val;

            li.addEventListener('click', function () {
              selectedOptions[optionIndex] = val;
              dropdownText.textContent = val;
              dropdown.classList.add('has-selection');
              dropdown.classList.remove('open');
              updateSelectedPrice();
            });

            dropdownList.appendChild(li);
          });


          
          dropdownBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            dropdown.classList.toggle('open');
          });

          group.appendChild(dropdown);
        }

        optionsWrapper.appendChild(group);
      });
    }

    function getSelectedVariant() {
      if (!currentProduct) return null;
      return currentProduct.variants.find(function (v) {
        return v.options.every(function (val, idx) {
          return val === selectedOptions[idx];
        });
      });
    }

    function updateSelectedPrice() {
      var variant = getSelectedVariant() || currentProduct.variants[0];
      if (variant) {
        modal.querySelector('.modal-product-price').textContent = formatMoney(variant.price);
      }
    }

    async function handleAddToCart() {
      var errorMsg = modal.querySelector('.cart-message');
      errorMsg.textContent = '';

      var variant = getSelectedVariant();

      if (!variant) {
        errorMsg.textContent = 'Please choose all options.';
        return;
      }

      if (!variant.available) {
        errorMsg.textContent = 'This variant is out of stock.';
        return;
      }

      var itemsToAdd = [
        {
          id: variant.id,
          quantity: 1
        }
      ];

      try {
        var optionValuesLower = variant.options.map(function (opt) {
          return String(opt).toLowerCase();
        });

        var hasBlack = optionValuesLower.includes('black');
        var hasMedium = optionValuesLower.includes('medium');

        if (hasBlack && hasMedium && bonusHandle && bonusHandle !== currentProduct.handle) {
          var bonusRes = await fetch('/products/' + bonusHandle + '.js');
          if (bonusRes.ok) {
            var bonusData = await bonusRes.json();
            var bonusVariant = bonusData.variants.find(function (v) {
              return v.available;
            });
            if (bonusVariant) {
              itemsToAdd.push({
                id: bonusVariant.id,
                quantity: 1
              });
            }
          }
        }




        
        var response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            items: itemsToAdd,
            sections: 'cart-drawer,cart-icon-bubble',
            sections_url: window.location.pathname
          })
        });


        
        var responseData = await response.json();

        if (!response.ok) {
          throw new Error(responseData.description || 'Could not add to cart.');
        }

        closeModal();



        
        var cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
          cartDrawer.classList.remove('is-empty');
          var inner = cartDrawer.querySelector('.drawer__inner');
          if (inner) inner.classList.remove('is-empty');

          cartDrawer.renderContents(responseData);

          setTimeout(function () {
            cartDrawer.classList.remove('is-empty');
            if (inner) inner.classList.remove('is-empty');
          }, 50);
        } else {
          window.location.href = '/cart';
        }
      } catch (err) {
        errorMsg.textContent = err.message || 'Something went wrong.';
      }
    }

    
    section.addEventListener('click', function (e) {
      var dot = e.target.closest('.view-product-dot');
      if (dot) {
        var id = dot.getAttribute('data-product-id');
        openModal(id);
      }
    });

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', closeModal);

    document.addEventListener('click', function () {
      var openDropdown = modal.querySelector('.custom-dropdown.open');
      if (openDropdown) {
        openDropdown.classList.remove('open');
      }
    });

    addToCartBtn.addEventListener('click', handleAddToCart);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  });
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Bonus Product (Black + Medium)"    }
  ],

  
  "blocks": [
    {
      "type": "product",
      "name": "Product Block",
     
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom Product Grid",
     
    }
  ]
}
{% endschema %}