<div class="custom-newsletter">
  <div class="page-width">
    <div class="custom-heading-newsletter-wrapper">
      <div class="heading-newsletter">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.paragraph }}</p>
      </div>

      <div class="footer-newsletter">
        {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="field__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="ContactFooter-error"
                {% elsif form.posted_successfully? %}
                  aria-describedby="ContactFooter-success"
                {% endif %}
                placeholder="Enter your Email"
                required
              >
              <button class="button-email" type="submit">SEND</button>
            </div>

            {%- if form.errors -%}
              <small class="newsletter-form__message form__message" id="ContactFooter-error">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <h3
                class="newsletter-form__message newsletter-form__message--success form__message"
                id="ContactFooter-success"
                tabindex="-1"
                autofocus
              >
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{- 'newsletter.success' | t }}
              </h3>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<style>
.custom-newsletter {
  background: #A02C6B;
  height: 350px;
  display: flex;
  align-items: center;
}

.heading-newsletter {
  text-align: center;
  padding-top: 20px;
}

.heading-newsletter h2 {
  font-size: 52px;
  font-weight: 700;
  line-height: 64px;
  color: white;
  margin: 0;
}

.heading-newsletter p {
  width: 512px;
  max-width: 90%;
  text-align: center;
  color: white;
  margin: auto;
  font-size: 16px;
  font-weight: 500;
  line-height: 32px;
  margin-bottom: 30px;
}
  field__input::input-placeholder {
  color: red;
}
.footer-newsletter {
  display: flex;
  justify-content: center;
}

.newsletter-form__field-wrapper .field {
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50px;
  padding: 5px;
  width: 500px;
  max-width: 90%;
  gap: 10px;
}

.field__input {
  flex: 1;
  padding: 15px 25px;
  font-size: 16px;
  border: none;
  border-radius: 50px;
  outline: none;
  background: transparent;
}

.button-email {
  padding: 14px 30px;
  border: none;
  border-radius: 50px;
  background-color: #A02C6B;
  color: white;
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
}

.newsletter-form__field-wrapper .field:before,
.newsletter-form__field-wrapper .field:after {
  box-shadow: none !important;
  content: none;
}
#ContactFooter input::placeholder {
  color: black;
  opacity: 1; 
}

@media screen and (max-width: 680px) {
  .heading-newsletter h2 {
    font-size: 32px;
    line-height: 42px;
  }
.heading-newsletter p {
    font-size: 14px;
    line-height: 26px;
    padding: 0 10px;
    width: 100%;
}

  ..newsletter-form__field-wrapper .field {
    /* flex-direction: column; */
    padding: 10px 15px;
    border-radius: 30px;
    display: flex;
    margin: auto;
    width: 100%;
}
  .button-email {
    padding: 12px;
  }
  .field__input, .button-email {
    width: 32%;
    border-radius: 30px;
    margin: auto;
}
  .newsletter-form__field-wrapper .field {
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 50px;
    padding: 5px;
    width: 100%;
    max-width: 90%;
    gap: 10px;
}
}
@media screen and (max-width: 420px) {
  .newsletter-form__field-wrapper .field {
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 50px;
    padding: 5px;
    width: 100%;
    max-width: 90%;
    gap: 10px;
}
  .heading-newsletter {
    text-align: center;
    padding-top: 20px;
    width: 100%;
}
.footer-newsletter {
    display: flex;
    justify-content: center;
    margin: auto;
    width: 100%;
    align-items: center;
    text-align: center;
}
  .heading-newsletter h2 {
    font-size: 36px;
    line-height: 42px;
}
  }
  
</style>

{% schema %}
  {
    "name": "Custom Newsletter",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "paragraph",
        "label": "Paragraph"
      }
    ],
    "presets": [
      {
        "name": "Custom Newsletter"
      }
    ]
  }
{% endschema %}
