<!DOCTYPE html>
<html>
<head>
  <title>Circular Percentage</title>
  <style>
    .circle-container {
      width: 7rem;
      height: 7rem;
      border-radius: 50%;
      background: conic-gradient(#c89dd8 0% 96%, #eee 96% 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
      color: #c89dd8;
      margin: 2rem;
      position: relative;
    }

    .circle-container::before {
      content: "";
      position: absolute;
      width: 5.5rem;
      height: 5.5rem;
      background: #fff;
      border-radius: 50%;
    }

    .circle-text {
      position: relative;
      z-index: 1;
    }
  </style>
</head>
<body>

  <div class="circle-container">
    <div class="circle-text">96%</div>
  </div>

</body>
</html>

