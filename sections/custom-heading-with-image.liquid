    line-height: 20px;
    /* text-align: center; */
}
    .image-wrapper .images-text {
    transition: background-color 0.3s ease;
    text-align: center;
    /* max-width: 100%; */
}
    .image-wrapper {
    display: block;
    justify-content: space-around;
    gap: 20px;
    padding-top: 25px;
}
   .img-banner-text h3 {
    font-size: 18px;
    font-weight: 600;
    color: white;
    line-height: 31px;
    max-width: 196px;
    width: 100%;
}
    .img-banner-text {
    text-align: left;
    position: relative;
    top: 46px;
    left: 60px;
}
    .img-banner-text {
    text-align: left;
    position: relative;
    top: 46px;
    left: 60px;
