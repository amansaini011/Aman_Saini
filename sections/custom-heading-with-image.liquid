{% schema %}
  {
    "name": "Custom Heading With Image",
    "settings": [
      {
        "type":"image_picker",
        "id":"image",
        "label":"Bg Image"
      },
     {
       "type":"text",
       "id":"heading",
       "label":"Heading"
     },
      {
        "type":"richtext",
        "id":"paragraph",
        "label":"Paragaph"
      },
      {
        "type":"text",
        "id":"head",
        "label":"Heading"
      },
      {
        "type":"text",
        "id":"button",
        "label":"Button Url"
      },
      {
        "type":"url",
        "id":"url",
        "label":"Button Url"
      }
    ], 
 "blocks": [
      {
        "type": "heading",
        "name": "Head Block",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "paragraph",
            "label": "Paragraph"
          }
        ]
      }
    ],
   "presets": [
      {
        "name": "Custom Heading With Image"
      }
    ]
  }
{% endschema %}