<div class="circle-container">
  <div class="circle">
    <svg width="80" height="80">
      <circle cx="40" cy="40" r="36" stroke="#dab2e4" stroke-width="8" fill="none" />
      <circle cx="40" cy="40" r="36" stroke="#b382c2" stroke-width="8" fill="none"
              stroke-linecap="round"
              stroke-dasharray="226.08"
              stroke-dashoffset="9" />
    </svg>
    <div class="percentage">96%</div>
  </div>
</div>

<style>
.circle-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100px;
}

.circle {
  position: relative;
  width: 80px;
  height: 80px;
}

.percentage {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-weight: bold;
  font-size: 18px;
  color: #b382c2;
}
</style>

{% schema %}
{
  "name": "Simple Scrolling Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Side Image"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Scrolling Word",
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Simple Scrolling Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
