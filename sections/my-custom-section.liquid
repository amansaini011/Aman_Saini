<div class="my-custom-box">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subheading }}</p>
  {% if section.settings.btn_text != blank %}
    <a href="{{ section.settings.btn_url }}" class="custom-btn">{{ section.settings.btn_text }}</a>
  {% endif %}
</div>

<style>
  .my-custom-box {
    background-color: #f4f4f4;
    padding: 40px 20px;
    text-align: center;
    border-radius: 8px;
    margin: 20px auto;
    max-width: 1200px;
  }
  .my-custom-box h2 {
    color: #333;
    font-size: 28px;
    margin-bottom: 10px;
  }
  .my-custom-box p {
    color: #666;
    font-size: 16px;
    margin-bottom: 20px;
  }
  .custom-btn {
    display: inline-block;
    background: #000;
    color: #fff;
    padding: 10px 25px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
  }
  .custom-btn:hover {
    background: #444;
  }
</style>

{% schema %}
{
  "name": "My Custom Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to My Store!"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ye hamara naya custom section hai jo CLI ke zariye add hua hai."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "My Custom Section"
    }
  ]
}
{% endschema %}