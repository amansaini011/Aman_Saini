{% if product %}
<style>
.custom-sticky-atc{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  width:100%;
  background:#fff;
  padding:12px 20px;
  box-shadow:0 -3px 15px rgba(0,0,0,.12);
  z-index:999999;

  opacity:0;
  visibility:hidden;
  transform:translateY(100%);
  transition:.3s ease;
}

.custom-sticky-atc.show{
  opacity:1;
  visibility:visible;
  transform:translateY(0);
  z-index:4;
}

.custom-sticky-atc__left{
  display:flex;
  align-items:center;
  gap:12px;
}

.custom-sticky-atc__image{
  width:60px;
  height:60px;
  border-radius:8px;
  object-fit:cover;
}

.custom-sticky-atc__title{
  font-size:15px;
  font-weight:600;
  line-height:1.3;
  margin:0;
}

.custom-sticky-atc__price{
  margin-top:4px;
  font-size:15px;
  font-weight:700;
}

.custom-sticky-atc__button{
  min-width:180px;
  height:52px;
  border:none;
  border-radius:50px;
  background:#000;
  color:#fff;
  font-size:14px;
  font-weight:700;
  cursor:pointer;
}

  .sticky-title-mobile{
  display:none;
}

.sticky-title-desktop{
  display:block;
}

.custom-sticky-atc__button:disabled{
  opacity:.5;
}



@media(max-width:749px){

.custom-sticky-atc{
  padding:10px;
}

.custom-sticky-atc__image{
  width:50px;
  height:50px;
}

.custom-sticky-atc__title{
  font-size:13px;
}

.custom-sticky-atc__price{
  font-size:14px;
}

.custom-sticky-atc__button{
  min-width:130px;
  height:46px;
  font-size:13px;
}

.sticky-title-desktop{
  display:none;
}

.sticky-title-mobile{
  display:block;
}

}
</style>

<div class="custom-sticky-atc">

  <div class="custom-sticky-atc__left">
<img
  id="StickyProductImage"
  class="custom-sticky-atc__image"
  src="{{ product.featured_image | image_url: width: 120 }}"
  alt="{{ product.title }}"
  width="120"
  height="120"
>

    <div>

      <h4
        class="custom-sticky-atc__title"
        id="StickyProductTitle"
      >
<span class="sticky-title-desktop">
  {{ product.title }}
</span>

<span class="sticky-title-mobile">
  {% assign words = product.title | split: ' ' %}
  {% for word in words limit: 2 %}
    {{ word }}{% unless forloop.last %} {% endunless %}
  {% endfor %}
  {% if words.size >2%}...{% endif %}
</span>      </h4>

      <div
        class="custom-sticky-atc__price"
        id="StickyProductPrice"
      >
        {{ product.selected_or_first_available_variant.price | money }}
      </div>

    </div>

  </div>

  <button
  type="button"
  class="custom-sticky-atc__button"
  id="CustomStickyAtcBtn"
>
  {{ section.settings.button_text }}
</button>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const stickyBar = document.querySelector('.custom-sticky-atc');
  const stickyBtn = document.getElementById('CustomStickyAtcBtn');
  const productForm = document.querySelector('form[action*="/cart/add"]');

  if (!stickyBar || !stickyBtn || !productForm) return;

  const realAddBtn = productForm.querySelector('button[name="add"], [type="submit"]');
  const variantInput = productForm.querySelector('input[name="id"]');

  function toggleStickyBar() {
    const rect = productForm.getBoundingClientRect();
    stickyBar.classList.toggle('show', rect.bottom < 0);
  }

  function updateStickyButton() {
    if (!realAddBtn) return;

   stickyBtn.textContent = realAddBtn.disabled
  ? (realAddBtn.textContent.trim() || 'Sold Out')
  : {{ section.settings.button_text | json }};
  }

  function updateStickyInfo() {
    if (!variantInput) return;

    fetch(`/variants/${variantInput.value}.js`)
      .then(res => res.json())
      .then(variant => {

        document.getElementById('StickyProductPrice').innerHTML =
          Shopify.formatMoney(variant.price, window.Shopify.money_format);

        if (variant.featured_image) {
          document.getElementById('StickyProductImage').src =
            variant.featured_image.src;
        }

      })
      .catch(console.error);
  }

  stickyBtn.addEventListener('click', () => {
    if (realAddBtn) {
      realAddBtn.click();
    } else {
      productForm.submit();
    }
  });


  toggleStickyBar();
  updateStickyButton();
  updateStickyInfo();


  window.addEventListener('scroll', toggleStickyBar);
  window.addEventListener('resize', toggleStickyBar);

  document.addEventListener('change', () => {
    setTimeout(() => {
      updateStickyButton();
      updateStickyInfo();
    }, 200);
  });

});
</script>
{% endif %}

{% schema %}
{
  "name": "Sticky Add to Cart22",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Cart"
    }
  ],
  "presets": [
    {
      "name": "Sticky Add to Cart22"
    }
  ]
}
{% endschema %}