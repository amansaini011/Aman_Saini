{% assign collection = collections[section.settings.collection] %}

<div class="custom-collection">
  <div class="custom-heading-product-banner">
    <div class="heading-custom-rictext">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.paragraph }}</p>
    </div>

    <div class="custom-coll-main-product-wrapper">
      <div class="custom-coll-main-product">
        {% for product in collection.products %}
       <div class="product-card
         {% if product.title == 'MIXED BERRY' %} mixed-berry{% endif %}
         {% if product.title == 'LEMON LIME' %} lemon-lime{% endif %}
         {% if product.title == 'ORANGE MANGO' %} orange-mango{% endif %}
       ">

          <div class="product-image-wrapper">
            <div class="product-image-bg"></div>
            <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
          </div>

          <div class="product-content">
            <h2 class="product-title">{{ product.title }}</h2>
            
            <p class="product-pack">12 PACKS</p>

            <div class="quantity-button-add-cart">
              <form method="post" action="/cart/add" class="custom-add-to-cart-form">
                <div class="quantity-wrapper">
                  <button type="button" class="qty-btn minus">–</button>
                  <input type="number" name="quantity" value="1" min="1" class="qty-input">
                  <button type="button" class="qty-btn plus">+</button>
                </div>
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="add-to-cart-btn">ADD TO CART</button>
              </form>
            </div>
            <div class="view-button">
                <a href="{{ product.url }}">
             <button type="detail" class="view-deatil-button">View Details</button>
                </a>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

