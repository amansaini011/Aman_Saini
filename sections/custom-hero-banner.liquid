<div class="custom-hero-banner">
  <div class="custom-hero-text-wrapper">
    <div class="image-text-heading">
      <div class="background-image" style="background-image: url('{{ section.settings.image | img_url: 'master' }}');">
        <div class="heading-image">
          <h2>{{ section.settings.heading }}</h2>
          <p>{{ section.settings.paragraph }}</p>
          <a href="{{ section.settings.url }}" class="buton-banner">{{ section.settings.button }}</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.custom-hero-banner {
  width: 100%;
}

.background-image {
  background-size: cover;
  background-position: center;
  color: white;
  text-align: center;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.heading-image {
  text-align: center;
  max-width: 608px;
  margin: auto;
}

.heading-image h2 {
  font-size: 42px;
  font-weight: 700;
  line-height: 52px;
  margin: 0;
  color: white;
}

.heading-image p {
  color: white;
  font-size: 18px;
  line-height: 26px;
  margin: 16px 0;
}

a.buton-banner {
  text-decoration: none;
  color: black;
  font-size: 16px;
  background-color: white;
  border-radius: 20px;
  padding: 10px 36px;
  display: inline-block;
  margin-top: 10px;
}


@media screen and (max-width: 768px) {
  .background-image {
    height: auto;
    padding: 60px 20px;
  }

  .heading-image {
    width: 100%;
  }

  .heading-image h2 {
    font-size: 28px;
    line-height: 40px;
  }

  .heading-image p {
    font-size: 16px;
    line-height: 24px;
  }

  a.buton-banner {
    font-size: 14px;
    padding: 8px 24px;
  }
  .heading-image {
    text-align: center;
    max-width: 500px;
    margin: auto;
}
}

@media screen and (max-width: 480px) {
  .heading-image h2 {
    font-size: 26px;
    line-height: 34px;
  }

  .heading-image p {
    font-size: 14px;
    line-height: 20px;
  }

  a.buton-banner {
    font-size: 13px;
    padding: 8px 20px;
  }
}
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}
